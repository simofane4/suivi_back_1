# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,172.16.0.49
DJANGO_ENV=dev

# Database (defaults to SQLite when unset)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS (comma separated)
DJANGO_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080

# JWT (minutes/days)
DJANGO_JWT_ACCESS_MINUTES=60
DJANGO_JWT_REFRESH_DAYS=7
