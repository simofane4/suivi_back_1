# Copy to .env and fill in real values. Never commit .env.

DJANGO_SETTINGS_MODULE=suivi_back.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Leave empty to allow any origin in DEBUG only.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

DJANGO_TIME_ZONE=Africa/Casablanca
DJANGO_LANGUAGE_CODE=fr

# Minutes
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1440
