# Development environment variables
DJANGO_SETTINGS_MODULE=suivi_back.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
DJANGO_DB_PATH=/app/db.sqlite3
DJANGO_TIME_ZONE=Africa/Casablanca
DJANGO_LANGUAGE_CODE=fr
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1440